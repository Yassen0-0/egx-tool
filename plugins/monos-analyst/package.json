{
  "name": "monos-analyst",
  "version": "1.0.0",
  "description": "Monos assistant: the «السجل» preset (no shell, no files, ledger tools only) as the default for new sessions",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./monos-assistant.patch.yml": "./monos-assistant.patch.yml"
  },
  "files": [
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "monos-assistant.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./monos-assistant.patch.yml"
      ]
    }
  },
  "monos": {
    "feature": "FEATURE.md"
  }
}
